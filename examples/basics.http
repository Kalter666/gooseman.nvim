# gooseman basics. Start the fake server first:
#   python3 tests/echo_server.py
# Put the cursor anywhere inside a block (between ###) and :Honk

# File variables: @name = value, used as {{name}}.
# Unknown {{NAME}} falls back to the environment variable NAME.
@host = http://localhost:8080

### plain GET with query string
GET {{host}}/geese?limit=3

### POST JSON; body starts after the first blank line
POST {{host}}/geese
Content-Type: application/json

{"name": "gooseman", "home": "{{HOME}}", "mood": "honking"}

### form body
POST {{host}}/geese
Content-Type: application/x-www-form-urlencoded

name=gooseman&mood=chaotic

### variables can be built from other variables and from shell commands
@today = $(date +%F)
@path = /log/{{today}}
GET {{host}}{{path}}

### raw curl flags for this request only: follow redirects, verbose, compressed
# @args -L --compressed
GET {{host}}/geese

### error statuses show up in the response header line
DELETE {{host}}/missing/42
